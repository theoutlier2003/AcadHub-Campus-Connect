# Database Configuration
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=acadnet
PG_USER=
PG_PASSWORD=

# Alternative: Full database URL (use this OR the individual settings above)
# DATABASE_URL=postgres://:@localhost:5432/acadnet

# JWT Secrets
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Email Configuration  
APP_EMAIL=
APP_PASSWORD=

# OAuth
CLIENT_ID=
CLIENT_PASSPORT=

# Server
BACKEND_PORT=
FRONTEND_PORT=
NODE_ENV=

# Documentation site (Next.js)
# Base URL of the existing Express backend, e.g. http://localhost:3000. Leave empty to use mock data.
NEXT_PUBLIC_API_BASE_URL=
# Only set if a real deployment of the AcadHub app exists.
NEXT_PUBLIC_DEMO_URL=
